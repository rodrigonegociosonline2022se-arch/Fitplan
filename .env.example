# Supabase > Project Settings > API
# Copie este arquivo para .env.local e preencha as duas variáveis públicas.
# Não publique .env.local ou a chave service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON

# Ative SOMENTE depois do webhook seguro estar validado.
VITE_FITPLAN_PAYWALL_ENABLED=false
VITE_CAKTO_CHECKOUT_URL=
